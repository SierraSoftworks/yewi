</div>
<code>--yw-surface</code>
</div>
<div style="--yw-gap:var(--yw-space-xs)" class="yw-stack">
<div style="background: var(--yw-surface-raised)" class="demo-swatch">
</div>
<code>--yw-surface-raised</code>
</div>
<div style="--yw-gap:var(--yw-space-xs)" class="yw-stack">
