<colgroup>
<col>
<col style="inline-size:12rem">
</colgroup>
<thead>
<tr>
<th scope="col" class="yi-table__header">Incident</th>
<th scope="col" class="yi-table__header">Opened</th>
</tr>
</thead>
<tbody>
<tr class="yi-table__row yi-table__row--placeholder">
<td class="yi-table__cell">
<span aria-hidden="true" class="yi-skeleton yi-skeleton--text yi-skeleton--shimmer">
<span class="yi-skeleton__bone">
</span>
</span>
</td>
<td class="yi-table__cell">
<span aria-hidden="true" class="yi-skeleton yi-skeleton--text yi-skeleton--shimmer">
<span class="yi-skeleton__bone">
</span>
</span>
</td>
</tr>
