<div class="yi-stack">
<div role="radiogroup" aria-label="Table state" class="yi-segmented yi-segmented--md">
<label class="yi-segmented__option">
<input value="loading" checked type="radio" name="yi-0" class="yi-segmented__input">
<span class="yi-segmented__label">Loading</span>
</label>
<label class="yi-segmented__option">
<input value="loaded" type="radio" name="yi-0" class="yi-segmented__input">
<span class="yi-segmented__label">Loaded</span>
</label>
<label class="yi-segmented__option">
<input value="refreshing" type="radio" name="yi-0" class="yi-segmented__input">
<span class="yi-segmented__label">Refreshing</span>
</label>
<label class="yi-segmented__option">
<input value="empty" type="radio" name="yi-0" class="yi-segmented__input">
<span class="yi-segmented__label">Empty</span>
</label>
</div>
<div class="yi-table yi-table--open yi-table--loading">
<div tabindex="0" class="yi-table__scroll">
