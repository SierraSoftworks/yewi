---
source: site/tests/snapshots.rs
---
<div class="yi-stack" style="max-inline-size: 24rem">
<div role="status" class="yi-toast yi-toast--ok">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon yi-toast__icon">
<path d="M2 12a10 10 0 1 0 20 0a10 10 0 1 0 -20 0M16 9l-5.5 5.5L8 12">
</path>
</svg>
<div class="yi-toast__body">
<div class="yi-toast__message">Settings saved.</div>
</div>
</div>
<div role="status" class="yi-toast yi-toast--info">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon yi-toast__icon">
<path d="M2 12a10 10 0 1 0 20 0a10 10 0 1 0 -20 0M12 16v-4M12 8h.01">
</path>
</svg>
<div class="yi-toast__body">
<div class="yi-toast__message">A new version is available.</div>
</div>
</div>
<div role="status" class="yi-toast yi-toast--warn">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon yi-toast__icon">
<path d="M21.73 18l-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3M12 9v4M12 17h.01">
</path>
</svg>
<div class="yi-toast__body">
<div class="yi-toast__title">Saved with warnings</div>
<div class="yi-toast__message">Two hosts were skipped because they are offline.</div>
</div>
</div>
<div role="alert" class="yi-toast yi-toast--danger">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon yi-toast__icon">
<path d="M2 12a10 10 0 1 0 20 0a10 10 0 1 0 -20 0M12 8L12 12M12 16L12.01 16">
</path>
</svg>
<div class="yi-toast__body">
<div class="yi-toast__title">Publishing failed</div>
<div class="yi-toast__message">The registry refused the upload.</div>
</div>
<button type="button" class="yi-button yi-button--default yi-button--sm yi-toast__action">Retry</button>
<button type="button" class="yi-button yi-button--subtle yi-button--sm yi-button--icon-only yi-toast__dismiss" aria-label="Dismiss" title="Dismiss">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon">
<path d="M18 6 6 18M6 6l12 12">
</path>
</svg>
</button>
</div>
<div role="status" class="yi-toast yi-toast--active">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon yi-toast__icon">
<path d="M21 12a9 9 0 1 1-6.219-8.56">
</path>
</svg>
<div class="yi-toast__body">
<div class="yi-toast__message">Rolling out to 12 hosts.</div>
</div>
</div>
<div role="status" class="yi-toast yi-toast--neutral">
<div class="yi-toast__body">
<div class="yi-toast__message">Copied to the clipboard.</div>
</div>
</div>
</div>
