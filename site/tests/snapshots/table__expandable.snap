<div class="yi-table yi-table--open">
<div tabindex="0" class="yi-table__scroll">
<table aria-label="Task runs" class="yi-table__grid">
<thead>
<tr>
<th scope="col" class="yi-table__header yi-table__control">
<span class="yi-visually-hidden">Details</span>
</th>
<th scope="col" class="yi-table__header">Task</th>
<th scope="col" class="yi-table__header">Result</th>
<th scope="col" class="yi-table__header yi-table__cell--end">Duration</th>
</tr>
</thead>
<tbody>
<tr class="yi-table__row">
<td class="yi-table__cell yi-table__control">
<span class="yi-table__toggle-box">
<button type="button" class="yi-button yi-button--subtle yi-button--sm yi-button--icon-only yi-table__toggle" aria-label="Details for Rotate certificates" title="Details for Rotate certificates" aria-expanded="false">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon">
<path d="M9 18l6-6-6-6">
</path>
</svg>
</button>
</span>
</td>
<th scope="row" class="yi-table__cell">Rotate certificates</th>
<td class="yi-table__cell">
<span class="yi-pill yi-pill--ok">
<span aria-hidden="true" class="yi-status-dot">
</span>Succeeded</span>
</td>
<td class="yi-table__cell yi-table__cell--end">12 s</td>
</tr>
<tr class="yi-table__row">
<td class="yi-table__cell yi-table__control">
<span class="yi-table__toggle-box">
<button type="button" class="yi-button yi-button--subtle yi-button--sm yi-button--icon-only yi-table__toggle" aria-label="Details for Prune images" title="Details for Prune images" aria-expanded="false">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon">
<path d="M9 18l6-6-6-6">
</path>
</svg>
</button>
</span>
</td>
<th scope="row" class="yi-table__cell">Prune images</th>
<td class="yi-table__cell">
<span class="yi-pill yi-pill--ok">
<span aria-hidden="true" class="yi-status-dot">
</span>Succeeded</span>
</td>
<td class="yi-table__cell yi-table__cell--end">48 s</td>
</tr>
<tr class="yi-table__row">
<td class="yi-table__cell yi-table__control">
<span class="yi-table__toggle-box">
<button type="button" class="yi-button yi-button--subtle yi-button--sm yi-button--icon-only yi-table__toggle" aria-label="Details for Back up database" title="Details for Back up database" aria-expanded="false">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon">
<path d="M9 18l6-6-6-6">
</path>
</svg>
</button>
</span>
</td>
<th scope="row" class="yi-table__cell">Back up database</th>
<td class="yi-table__cell">
<span class="yi-pill yi-pill--danger">
<span aria-hidden="true" class="yi-status-dot">
</span>Failed</span>
</td>
<td class="yi-table__cell yi-table__cell--end">4 min</td>
</tr>
</tbody>
</table>
</div>
</div>
