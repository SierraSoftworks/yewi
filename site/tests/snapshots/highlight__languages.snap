<span class="yi-tok-comment">#!/usr/bin/env bash</span>
<span class="yi-tok-function">set</span> -euo pipefail

<span class="yi-tok-keyword">export</span> <span class="yi-tok-variable">NOMAD_ADDR</span>=<span class="yi-tok-string">"https://nomad.example.com"</span>
<span class="yi-tok-keyword">for</span> region <span class="yi-tok-keyword">in</span> fra ams; <span class="yi-tok-keyword">do</span>
  <span class="yi-tok-keyword">if</span> ! nomad job run -var <span class="yi-tok-string">"region=$region"</span> docs.hcl; <span class="yi-tok-keyword">then</span>
    <span class="yi-tok-function">echo</span> <span class="yi-tok-string">"rollout failed in ${region}"</span> &gt;&amp;<span class="yi-tok-number">2</span> <span class="yi-tok-comment"># keep going</span>
  <span class="yi-tok-keyword">fi</span>
<span class="yi-tok-keyword">done</span>
