<pre tabindex="0" class="yi-code-block__body">
<code class="yi-highlight">
<span class="yi-tok-meta">#[derive(Debug, Clone)]</span>
<span class="yi-tok-keyword">pub</span> <span class="yi-tok-keyword">struct</span> <span class="yi-tok-type">Rollout</span>&lt;<span class="yi-tok-meta">'a</span>&gt; {
    job: &amp;<span class="yi-tok-meta">'a</span> <span class="yi-tok-type">str</span>,
    healthy: <span class="yi-tok-type">u32</span>, <span class="yi-tok-comment">// of `count`</span>
}

<span class="yi-tok-keyword">impl</span> <span class="yi-tok-type">Rollout</span>&lt;<span class="yi-tok-meta">'_</span>&gt; {
    <span class="yi-tok-keyword">pub</span> <span class="yi-tok-keyword">fn</span> <span class="yi-tok-function">done</span>(&amp;<span class="yi-tok-keyword">self</span>, count: <span class="yi-tok-type">u32</span>) -&gt; <span class="yi-tok-type">bool</span> {
        <span class="yi-tok-meta">println!</span>(<span class="yi-tok-string">"{}: {}/{count}"</span>, <span class="yi-tok-keyword">self</span>.job, <span class="yi-tok-keyword">self</span>.healthy);
        <span class="yi-tok-keyword">self</span>.healthy &gt;= count &amp;&amp; count != <span class="yi-tok-number">0</span>
    }
}</code>
</pre>
