<div class="yi-code-block">
<div class="yi-code-block__header">
<span class="yi-code-block__language">JavaScript</span>
</div>
<pre tabindex="0" class="yi-code-block__body">
<code class="yi-highlight">
<span class="yi-tok-keyword">import</span> { status } <span class="yi-tok-keyword">from</span> <span class="yi-tok-string">"./api.js"</span>;

<span class="yi-tok-comment">/* Poll until every allocation is healthy. */</span>
<span class="yi-tok-keyword">export</span> <span class="yi-tok-keyword">function</span> <span class="yi-tok-function">watch</span>(job, onDone) {
  <span class="yi-tok-keyword">const</span> timer = <span class="yi-tok-function">setInterval</span>(<span class="yi-tok-keyword">async</span> () =&gt; {
    <span class="yi-tok-keyword">const</span> { healthy, count } = <span class="yi-tok-keyword">await</span> <span class="yi-tok-function">status</span>(job);
    <span class="yi-tok-keyword">if</span> (healthy === count) <span class="yi-tok-function">clearInterval</span>(timer), <span class="yi-tok-function">onDone</span>(<span class="yi-tok-literal">null</span>);
  }, <span class="yi-tok-number">2_000</span>);
}</code>
</pre>
</div>
<div class="yi-code-block">
<div class="yi-code-block__header">
<span class="yi-code-block__language">Python</span>
</div>
<pre tabindex="0" class="yi-code-block__body">
<code class="yi-highlight">
<span class="yi-tok-keyword">from</span> dataclasses <span class="yi-tok-keyword">import</span> dataclass

<span class="yi-tok-meta">@dataclass</span>
<span class="yi-tok-keyword">class</span> <span class="yi-tok-type">Rollout</span>:
    <span class="yi-tok-string">"""One job being rolled out."""</span>
    job: <span class="yi-tok-type">str</span>
    healthy: <span class="yi-tok-type">int</span> = <span class="yi-tok-number">0</span>

    <span class="yi-tok-keyword">def</span> <span class="yi-tok-function">done</span>(self, count: <span class="yi-tok-type">int</span>) -&gt; <span class="yi-tok-type">bool</span>:
        <span class="yi-tok-function">print</span>(<span class="yi-tok-string">f"{self.job}: {self.healthy}/{count}"</span>)  <span class="yi-tok-comment"># progress</span>
        <span class="yi-tok-keyword">return</span> self.healthy &gt;= count <span class="yi-tok-keyword">and</span> count != <span class="yi-tok-number">0</span>
</code>
</pre>
</div>
<div class="yi-code-block">
<div class="yi-code-block__header">
<span class="yi-code-block__language">Go</span>
</div>
<pre tabindex="0" class="yi-code-block__body">
<code class="yi-highlight">
<span class="yi-tok-keyword">package</span> rollout

<span class="yi-tok-keyword">import</span> <span class="yi-tok-string">"fmt"</span>

<span class="yi-tok-comment">// Done reports whether every allocation is healthy.</span>
<span class="yi-tok-keyword">func</span> (r *Rollout) <span class="yi-tok-function">Done</span>(count <span class="yi-tok-type">int</span>) <span class="yi-tok-type">bool</span> {
	fmt.<span class="yi-tok-function">Printf</span>(<span class="yi-tok-string">"%s: %d/%d\n"</span>, r.Job, r.Healthy, count)
	<span class="yi-tok-keyword">return</span> r.Healthy &gt;= count &amp;&amp; count != <span class="yi-tok-number">0</span>
}</code>
</pre>
</div>
<div class="yi-code-block">
<div class="yi-code-block__header">
<span class="yi-code-block__language">SQL</span>
</div>
<pre tabindex="0" class="yi-code-block__body">
<code class="yi-highlight">
<span class="yi-tok-keyword">SELECT</span> job, <span class="yi-tok-function">count</span>(*) <span class="yi-tok-keyword">AS</span> healthy
<span class="yi-tok-keyword">FROM</span> allocations
<span class="yi-tok-keyword">WHERE</span> status = <span class="yi-tok-string">'running'</span> <span class="yi-tok-keyword">AND</span> started_at &gt; <span class="yi-tok-function">now</span>() - interval <span class="yi-tok-string">'5 minutes'</span>
<span class="yi-tok-keyword">GROUP</span> <span class="yi-tok-keyword">BY</span> job
<span class="yi-tok-keyword">HAVING</span> <span class="yi-tok-function">count</span>(*) &gt;= <span class="yi-tok-number">4</span> <span class="yi-tok-comment">-- the whole group</span>
<span class="yi-tok-keyword">ORDER</span> <span class="yi-tok-keyword">BY</span> job;</code>
</pre>
