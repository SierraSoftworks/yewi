<div class="yi-code-block">
<div class="yi-code-block__header">
<span class="yi-code-block__language">TypeScript</span>
</div>
<pre tabindex="0" class="yi-code-block__body">
<code class="yi-highlight">
<span class="yi-tok-keyword">interface</span> <span class="yi-tok-type">Rollout</span> {
  <span class="yi-tok-keyword">readonly</span> job: <span class="yi-tok-type">string</span>;
  healthy: <span class="yi-tok-type">number</span>; <span class="yi-tok-comment">// of `count`</span>
}

<span class="yi-tok-keyword">export</span> <span class="yi-tok-keyword">async</span> <span class="yi-tok-keyword">function</span> <span class="yi-tok-function">wait</span>(rollout: <span class="yi-tok-type">Rollout</span>, count = <span class="yi-tok-number">4</span>): <span class="yi-tok-type">Promise</span>&lt;<span class="yi-tok-type">boolean</span>&gt; {
  <span class="yi-tok-keyword">const</span> response = <span class="yi-tok-keyword">await</span> <span class="yi-tok-function">fetch</span>(<span class="yi-tok-string">`/v1/jobs/${rollout.job}`</span>);
  <span class="yi-tok-keyword">return</span> response.ok &amp;&amp; rollout.healthy &gt;= count;
}</code>
