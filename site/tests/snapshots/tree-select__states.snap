---
source: site/tests/snapshots.rs
---
<div style="--yi-grid-min:14rem" class="yi-grid">
<div style="--yi-gap:var(--yi-space-xs)" class="yi-stack">
<label for="tree-small" style="font-size: var(--yi-text-sm); font-weight: 500">Small</label>
<div class="yi-select yi-tree-select">
<span class="yi-popover">
<button type="button" id="tree-small" role="combobox" aria-haspopup="listbox" aria-expanded="false" class="yi-input yi-input--sm yi-select__control yi-select__trigger">
<span class="yi-select__value">Ireland</span>
<span class="yi-tree-select__detail">IE</span>
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon yi-select__chevron">
<path d="M6 9l6 6 6-6">
</path>
</svg>
</button>
</span>
</div>
</div>
<div style="--yi-gap:var(--yi-space-xs)" class="yi-stack">
<label for="tree-medium" style="font-size: var(--yi-text-sm); font-weight: 500">Medium</label>
<div class="yi-select yi-tree-select">
<span class="yi-popover">
<button type="button" id="tree-medium" role="combobox" aria-haspopup="listbox" aria-expanded="false" class="yi-input yi-input--md yi-select__control yi-select__trigger">
<span class="yi-select__value">Ireland</span>
<span class="yi-tree-select__detail">IE</span>
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon yi-select__chevron">
<path d="M6 9l6 6 6-6">
</path>
</svg>
</button>
</span>
</div>
</div>
<div style="--yi-gap:var(--yi-space-xs)" class="yi-stack">
<label for="tree-large" style="font-size: var(--yi-text-sm); font-weight: 500">Large</label>
<div class="yi-select yi-tree-select">
<span class="yi-popover">
<button type="button" id="tree-large" role="combobox" aria-haspopup="listbox" aria-expanded="false" class="yi-input yi-input--lg yi-select__control yi-select__trigger">
<span class="yi-select__value">Ireland</span>
<span class="yi-tree-select__detail">IE</span>
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon yi-select__chevron">
<path d="M6 9l6 6 6-6">
</path>
</svg>
</button>
</span>
</div>
</div>
<div style="--yi-gap:var(--yi-space-xs)" class="yi-stack">
<label for="tree-empty" style="font-size: var(--yi-text-sm); font-weight: 500">Empty</label>
<div class="yi-select yi-tree-select">
<span class="yi-popover">
<button type="button" id="tree-empty" role="combobox" aria-haspopup="listbox" aria-expanded="false" class="yi-input yi-input--md yi-select__control yi-select__trigger">
<span class="yi-select__value yi-select__value--placeholder">Choose a country</span>
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon yi-select__chevron">
<path d="M6 9l6 6 6-6">
</path>
</svg>
</button>
</span>
</div>
</div>
<div style="--yi-gap:var(--yi-space-xs)" class="yi-stack">
<label for="tree-disabled" style="font-size: var(--yi-text-sm); font-weight: 500">Disabled</label>
<div class="yi-select yi-tree-select">
<span class="yi-popover">
<button type="button" id="tree-disabled" role="combobox" aria-haspopup="listbox" aria-expanded="false" disabled="disabled" class="yi-input yi-input--md yi-select__control yi-select__trigger">
<span class="yi-select__value">Ireland</span>
<span class="yi-tree-select__detail">IE</span>
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon yi-select__chevron">
<path d="M6 9l6 6 6-6">
</path>
</svg>
</button>
</span>
</div>
</div>
<div style="--yi-gap:var(--yi-space-xs)" class="yi-stack">
<label for="tree-invalid" style="font-size: var(--yi-text-sm); font-weight: 500">Invalid</label>
<div class="yi-select yi-tree-select">
<span class="yi-popover">
<button type="button" id="tree-invalid" role="combobox" aria-haspopup="listbox" aria-expanded="false" aria-invalid="true" class="yi-input yi-input--md yi-input--invalid yi-select__control yi-select__trigger">
<span class="yi-select__value">Ireland</span>
<span class="yi-tree-select__detail">IE</span>
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon yi-select__chevron">
<path d="M6 9l6 6 6-6">
</path>
</svg>
</button>
</span>
</div>
</div>
<div style="--yi-gap:var(--yi-space-xs)" class="yi-stack">
<label for="tree-unlisted" style="font-size: var(--yi-text-sm); font-weight: 500">A value the tree does not list</label>
<div class="yi-select yi-tree-select">
<span class="yi-popover">
<button type="button" id="tree-unlisted" role="combobox" aria-haspopup="listbox" aria-expanded="false" class="yi-input yi-input--md yi-select__control yi-select__trigger">
<span class="yi-select__value">xk</span>
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon yi-select__chevron">
<path d="M6 9l6 6 6-6">
</path>
</svg>
</button>
</span>
</div>
</div>
<div style="--yi-gap:var(--yi-space-xs)" class="yi-stack">
<label for="tree-fit" style="font-size: var(--yi-text-sm); font-weight: 500">Fit, submitted as country</label>
<div>
<div class="yi-select yi-tree-select yi-select--fit">
<span class="yi-popover">
<button type="button" id="tree-fit" role="combobox" aria-haspopup="listbox" aria-expanded="false" class="yi-input yi-input--md yi-select__control yi-select__trigger">
<span class="yi-select__value">Brazil</span>
<span class="yi-tree-select__detail">BR</span>
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon yi-select__chevron">
<path d="M6 9l6 6 6-6">
</path>
</svg>
</button>
</span>
<input value="br" type="hidden" name="country">
</div>
</div>
</div>
</div>
