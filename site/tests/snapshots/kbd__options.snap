<div class="yi-stack">
<p class="yi-text">
<span class="yi-text yi-text--medium">Tinted (default): </span>open the palette with <kbd class="yi-kbd-combo">
<kbd class="yi-kbd">Ctrl</kbd>
<span class="yi-kbd-combo__plus">+</span>
<kbd class="yi-kbd">K</kbd>
</kbd>.</p>
<p class="yi-text">
<span class="yi-text yi-text--medium">Outlined: </span>open the palette with <kbd class="yi-kbd-combo" style="--yi-kbd-bg: var(--yi-surface); --yi-kbd-border: var(--yi-line-strong)">
<kbd class="yi-kbd">Ctrl</kbd>
<span class="yi-kbd-combo__plus">+</span>
<kbd class="yi-kbd">K</kbd>
</kbd>.</p>
<p class="yi-text">
<span class="yi-text yi-text--medium">Raised cap: </span>open the palette with <kbd class="yi-kbd-combo" style="--yi-kbd-bg: var(--yi-surface); --yi-kbd-border: var(--yi-line-strong); --yi-kbd-depth: 2px">
<kbd class="yi-kbd">Ctrl</kbd>
<span class="yi-kbd-combo__plus">+</span>
<kbd class="yi-kbd">K</kbd>
</kbd>.</p>
</div>
