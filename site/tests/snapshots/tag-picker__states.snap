<div style="--yi-grid-min:16rem" class="yi-grid">
<div style="--yi-gap:var(--yi-space-xs)" class="yi-stack">
<span style="font-size: var(--yi-text-sm); font-weight: 500" aria-hidden="true">Empty</span>
<div class="yi-select yi-tag-picker">
<span class="yi-popover">
<span class="yi-input yi-input--md yi-select__control yi-select__combobox yi-tag-picker__control">
<input value="" type="text" role="combobox" placeholder="Add days" autocomplete="off" autocapitalize="none" spellcheck="false" aria-autocomplete="list" aria-haspopup="listbox" aria-expanded="false" aria-label="Empty" class="yi-select__input yi-tag-picker__input">
</span>
</span>
</div>
</div>
<div style="--yi-gap:var(--yi-space-xs)" class="yi-stack">
<span style="font-size: var(--yi-text-sm); font-weight: 500" aria-hidden="true">Chosen</span>
<div class="yi-select yi-tag-picker">
<span class="yi-popover">
<span class="yi-input yi-input--md yi-select__control yi-select__combobox yi-tag-picker__control">
<span role="list" class="yi-tag-picker__tags">
<span role="listitem" class="yi-tag yi-tag--neutral yi-tag-picker__tag">
<span class="yi-tag__text">
<span class="yi-tag__value">Monday</span>
</span>
<button type="button" aria-label="Remove Monday" class="yi-tag__remove">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon">
<path d="M18 6 6 18M6 6l12 12">
</path>
</svg>
</button>
</span>
<span role="listitem" class="yi-tag yi-tag--neutral yi-tag-picker__tag">
<span class="yi-tag__text">
<span class="yi-tag__value">Friday</span>
</span>
<button type="button" aria-label="Remove Friday" class="yi-tag__remove">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon">
<path d="M18 6 6 18M6 6l12 12">
</path>
</svg>
</button>
</span>
</span>
<input value="" type="text" role="combobox" autocomplete="off" autocapitalize="none" spellcheck="false" aria-autocomplete="list" aria-haspopup="listbox" aria-expanded="false" aria-label="Chosen" class="yi-select__input yi-tag-picker__input">
</span>
</span>
</div>
</div>
