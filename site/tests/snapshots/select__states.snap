<div style="--yi-grid-min:14rem" class="yi-grid">
<div class="yi-field yi-field--stacked">
<label id="yi-0-label" for="yi-0-control" class="yi-field__label">Small</label>
<div class="yi-field__body">
<div class="yi-select">
<span class="yi-popover">
<button type="button" id="yi-0-control" role="combobox" aria-haspopup="listbox" aria-expanded="false" class="yi-input yi-input--sm yi-select__control yi-select__trigger">
<span class="yi-select__value">Ireland</span>
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon yi-select__chevron">
<path d="M6 9l6 6 6-6">
</path>
</svg>
</button>
</span>
</div>
</div>
</div>
<div class="yi-field yi-field--stacked">
