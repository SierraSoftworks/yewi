<div class="yi-field__body">
<div class="yi-select">
<span class="yi-popover">
<button type="button" id="yi-15-control" role="combobox" aria-haspopup="listbox" aria-expanded="false" aria-invalid="true" aria-describedby="yi-15-message" class="yi-input yi-input--md yi-input--invalid yi-select__control yi-select__trigger">
<span class="yi-select__value">Virginia</span>
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon yi-select__chevron">
<path d="M6 9l6 6 6-6">
</path>
</svg>
</button>
</span>
</div>
<p id="yi-15-message" role="alert" class="yi-field__message yi-field__message--error">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon">
<path d="M2 12a10 10 0 1 0 20 0a10 10 0 1 0 -20 0M12 8L12 12M12 16L12.01 16">
</path>
</svg>
<span>This region is being retired.</span>
</p>
