<div class="yi-field yi-field--stacked">
<label id="yi-12-label" for="yi-12-control" class="yi-field__label">Disabled</label>
<div class="yi-field__body">
<div class="yi-select">
<span class="yi-popover">
<button type="button" id="yi-12-control" role="combobox" aria-haspopup="listbox" aria-expanded="false" disabled="disabled" class="yi-input yi-input--md yi-select__control yi-select__trigger">
<span class="yi-select__value">Ireland</span>
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon yi-select__chevron">
