<div class="yi-stack">
<div role="group" aria-labelledby="yi-0-label" class="yi-field yi-field--stacked">
<span id="yi-0-label" class="yi-field__label">Role</span>
<div class="yi-field__body">
<div role="radiogroup" aria-labelledby="yi-0-label" class="yi-radio-group yi-radio-group--vertical">
<label class="yi-choice yi-choice--md yi-radio">
<span class="yi-choice__control">
<input value="viewer" checked type="radio" name="yi-1" class="yi-radio__input">
</span>
<span class="yi-choice__text">
<span class="yi-choice__label">Viewer</span>
<span class="yi-choice__description">Can see deploys and logs.</span>
</span>
</label>
<label class="yi-choice yi-choice--md yi-radio">
<span class="yi-choice__control">
<input value="operator" type="radio" name="yi-1" class="yi-radio__input">
</span>
<span class="yi-choice__text">
<span class="yi-choice__label">Operator</span>
<span class="yi-choice__description">Can start, pause and roll back deploys.</span>
</span>
</label>
<label class="yi-choice yi-choice--md yi-choice--disabled yi-radio">
<span class="yi-choice__control">
<input value="owner" type="radio" name="yi-1" disabled="disabled" class="yi-radio__input">
</span>
<span class="yi-choice__text">
<span class="yi-choice__label">Owner</span>
<span class="yi-choice__description">Only an existing owner can grant this.</span>
</span>
</label>
</div>
</div>
</div>
<span role="status">Role: viewer</span>
</div>
