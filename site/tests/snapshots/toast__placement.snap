<div class="yi-stack">
<div class="yi-cluster">
<button type="button" class="yi-button yi-button--default yi-button--md" aria-pressed="false">Top start</button>
<button type="button" class="yi-button yi-button--default yi-button--md" aria-pressed="false">Top center</button>
<button type="button" class="yi-button yi-button--default yi-button--md" aria-pressed="false">Top end</button>
<button type="button" class="yi-button yi-button--default yi-button--md" aria-pressed="false">Bottom start</button>
<button type="button" class="yi-button yi-button--default yi-button--md" aria-pressed="false">Bottom center</button>
<button type="button" class="yi-button yi-button--default yi-button--md" aria-pressed="true">Bottom end</button>
</div>
<div class="yi-cluster">
<button type="button" class="yi-button yi-button--primary yi-button--md">Notify</button>
</div>
</div>
<div role="region" aria-label="Notifications" aria-live="polite" class="yi-toast-region yi-toast-region--bottom-end">
</div>
