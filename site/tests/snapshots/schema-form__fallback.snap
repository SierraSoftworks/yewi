---
source: site/tests/snapshots.rs
---
<div class="yi-stack" style="max-inline-size: 28rem">
<label class="yi-choice yi-choice--md yi-switch">
<span class="yi-choice__control">
<input type="checkbox" role="switch" class="yi-switch__input">
</span>
<span class="yi-choice__text">
<span class="yi-choice__label">Saving</span>
</span>
</label>
<div class="yi-schema-form yi-schema-form--boxed">
<div class="yi-field yi-field--stacked" data-yi-pointer="/image">
<label id="yi-2-label" for="yi-2-control" class="yi-field__label">Image<span aria-hidden="true" class="yi-field__required">*</span>
</label>
<div class="yi-field__body">
<input value="caddy:2.8" id="yi-2-control" type="text" required="required" class="yi-input yi-input--md">
</div>
</div>
<div class="yi-field yi-field--stacked" data-yi-pointer="/replicas">
<label id="yi-4-label" for="yi-4-control" class="yi-field__label">Replicas</label>
<div class="yi-field__body">
<div class="yi-input yi-number-input yi-input--md">
<input value="2" id="yi-4-control" type="text" role="spinbutton" inputmode="numeric" autocomplete="off" aria-valuenow="2" aria-valuemin="1" class="yi-number-input__input">
<span class="yi-number-input__steps">
<button type="button" tabindex="-1" aria-label="Decrease" class="yi-number-input__step">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon">
<path d="M5 12h14">
</path>
</svg>
</button>
<button type="button" tabindex="-1" aria-label="Increase" class="yi-number-input__step">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon">
<path d="M5 12h14M12 5v14">
</path>
</svg>
</button>
</span>
</div>
</div>
</div>
<div class="yi-field yi-field--stacked" data-yi-pointer="/env">
<label id="yi-6-label" for="yi-6-control" class="yi-field__label">Environment</label>
<div class="yi-field__body">
<textarea id="yi-6-control" rows="4" spellcheck="false" aria-describedby="yi-6-message" class="yi-input yi-input--md yi-input--mono yi-input--multiline yi-input--resize-vertical">{
  "LOG_LEVEL": "info"
}</textarea>
<p id="yi-6-message" class="yi-field__message">Variables passed to the container, as a JSON object.</p>
</div>
</div>
</div>
<code role="status">{"image":"caddy:2.8","replicas":2,"env":{"LOG_LEVEL":"info"}}</code>
</div>
