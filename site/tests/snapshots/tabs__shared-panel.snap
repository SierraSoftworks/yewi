<div class="yi-tabs yi-tabs--pill yi-tabs--sm">
<div role="tablist" aria-label="Break down by" class="yi-tabs__list">
<button type="button" role="tab" id="yi-0-tab-0" aria-selected="true" aria-controls="yi-0-panel" tabindex="0" class="yi-tabs__tab">
<span class="yi-tabs__label">Pages</span>
</button>
<button type="button" role="tab" id="yi-0-tab-1" aria-selected="false" tabindex="-1" class="yi-tabs__tab">
<span class="yi-tabs__label">Browsers</span>
</button>
</div>
<div role="tabpanel" id="yi-0-panel" aria-labelledby="yi-0-tab-0" tabindex="0" class="yi-tabs__panel">
<div class="yi-bar-list yi-bar-list--behind yi-bar-list--md">
<ol role="list" aria-label="Visitors" class="yi-bar-list__rows">
<li style="--yi-bar-list-fill:100.0%" class="yi-bar-list__item">
<div class="yi-bar-list__row">
<span class="yi-bar-list__label">
<span class="yi-bar-list__text">/</span>
</span>
<span class="yi-bar-list__value">2.2k</span>
</div>
</li>
<li style="--yi-bar-list-fill:50.0%" class="yi-bar-list__item">
<div class="yi-bar-list__row">
<span class="yi-bar-list__label">
<span class="yi-bar-list__text">/docs</span>
</span>
<span class="yi-bar-list__value">1.1k</span>
</div>
</li>
<li style="--yi-bar-list-fill:25.1%" class="yi-bar-list__item">
<div class="yi-bar-list__row">
<span class="yi-bar-list__label">
<span class="yi-bar-list__text">/pricing</span>
</span>
