<button type="button" class="yi-button yi-button--default yi-button--sm" aria-pressed="false">Bottom</button>
<button type="button" class="yi-button yi-button--default yi-button--sm" aria-pressed="false">BottomStart</button>
<button type="button" class="yi-button yi-button--default yi-button--sm" aria-pressed="false">BottomEnd</button>
<button type="button" class="yi-button yi-button--default yi-button--sm" aria-pressed="false">Left</button>
<button type="button" class="yi-button yi-button--default yi-button--sm" aria-pressed="false">LeftStart</button>
<button type="button" class="yi-button yi-button--default yi-button--sm" aria-pressed="false">LeftEnd</button>
<button type="button" class="yi-button yi-button--default yi-button--sm" aria-pressed="false">Right</button>
