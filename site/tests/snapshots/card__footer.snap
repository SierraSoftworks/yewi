<section class="yi-card yi-card--header-plain" style="max-inline-size: 28rem">
<header class="yi-card__header">
<div class="yi-card__heading">
<h2 class="yi-card__title">Maintenance window</h2>
<p class="yi-card__subtitle">Rollouts only start inside this window</p>
</div>
</header>
<div class="yi-card__body">Weekdays from 22:00 to 04:00, in the fleet's local time.</div>
<footer class="yi-card__footer">
<button type="button" class="yi-button yi-button--default yi-button--md">Cancel</button>
<button type="button" class="yi-button yi-button--primary yi-button--md">Save changes</button>
</footer>
</section>
