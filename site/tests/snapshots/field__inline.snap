---
source: site/tests/snapshots.rs
---
<div class="yi-stack" style="max-inline-size: 32rem">
<div class="yi-field yi-field--inline">
<label id="yi-0-label" for="yi-0-control" class="yi-field__label">Display name</label>
<div class="yi-field__body">
<input value="Production" id="yi-0-control" type="text" class="yi-input yi-input--md">
</div>
</div>
<div class="yi-field yi-field--inline">
<label id="yi-1-label" for="yi-1-control" class="yi-field__label">Webhook URL<span aria-hidden="true" class="yi-field__required">*</span>
</label>
<div class="yi-field__body">
<input id="yi-1-control" type="url" placeholder="https://" aria-describedby="yi-1-message" required="required" class="yi-input yi-input--md">
<p id="yi-1-message" class="yi-field__message">Called after every rollout.</p>
</div>
</div>
<div class="yi-field yi-field--inline yi-field--invalid">
<label id="yi-2-label" for="yi-2-control" class="yi-field__label">Retries</label>
<div class="yi-field__body">
<div class="yi-input yi-number-input yi-input--md yi-input--invalid">
<input value="12" id="yi-2-control" type="text" role="spinbutton" inputmode="numeric" autocomplete="off" aria-valuenow="12" aria-valuemin="0" aria-valuemax="10" aria-invalid="true" aria-describedby="yi-2-message" class="yi-number-input__input">
<span class="yi-number-input__steps">
<button type="button" tabindex="-1" aria-label="Decrease" class="yi-number-input__step">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon">
<path d="M5 12h14">
</path>
</svg>
</button>
<button type="button" tabindex="-1" aria-label="Increase" disabled="disabled" class="yi-number-input__step">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon">
<path d="M5 12h14M12 5v14">
</path>
</svg>
</button>
</span>
</div>
<p id="yi-2-message" role="alert" class="yi-field__message yi-field__message--error">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon">
<path d="M2 12a10 10 0 1 0 20 0a10 10 0 1 0 -20 0M12 8L12 12M12 16L12.01 16">
</path>
</svg>
<span>Must be between 0 and 10.</span>
</p>
</div>
</div>
</div>
