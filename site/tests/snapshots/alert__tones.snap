---
source: site/tests/snapshots.rs
---
<div class="yi-stack">
<div role="status" class="yi-alert yi-alert--info">
<span class="yi-alert__icon">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon">
<path d="M2 12a10 10 0 1 0 20 0a10 10 0 1 0 -20 0M12 16v-4M12 8h.01">
</path>
</svg>
</span>
<div class="yi-alert__body">
<div class="yi-alert__title">Certificate renewed</div>
<div class="yi-alert__message">The new certificate is valid until 14 April 2026.</div>
</div>
</div>
<div role="status" class="yi-alert yi-alert--ok">
<span class="yi-alert__icon">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon">
<path d="M2 12a10 10 0 1 0 20 0a10 10 0 1 0 -20 0M16 9l-5.5 5.5L8 12">
</path>
</svg>
</span>
<div class="yi-alert__body">
<div class="yi-alert__message">All 31 hosts are running the latest release.</div>
</div>
</div>
<div role="alert" class="yi-alert yi-alert--warn">
<span class="yi-alert__icon">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon">
<path d="M21.73 18l-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3M12 9v4M12 17h.01">
</path>
</svg>
</span>
<div class="yi-alert__body">
<div class="yi-alert__title">Certificate expires in 6 days</div>
<div class="yi-alert__message">Renewal is waiting for a DNS record to propagate.</div>
</div>
</div>
<div role="alert" class="yi-alert yi-alert--danger">
<span class="yi-alert__icon">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon">
<path d="M2 12a10 10 0 1 0 20 0a10 10 0 1 0 -20 0M12 8L12 12M12 16L12.01 16">
</path>
</svg>
</span>
<div class="yi-alert__body">
<div class="yi-alert__title">Rollout failed</div>
<div class="yi-alert__message">3 of 31 hosts did not pass their health check and were rolled back.</div>
</div>
</div>
<div role="status" class="yi-alert yi-alert--active">
<span class="yi-alert__icon">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon">
<path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8M21 3v5h-5M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16M8 16H3v5">
</path>
</svg>
</span>
<div class="yi-alert__body">
<div class="yi-alert__title">Rollout in progress</div>
<div class="yi-alert__message">12 of 31 hosts done.</div>
</div>
</div>
<div role="status" class="yi-alert yi-alert--neutral">
<span class="yi-alert__icon">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon">
<path d="M2 12a10 10 0 1 0 20 0a10 10 0 1 0 -20 0M12 16v-4M12 8h.01">
</path>
</svg>
</span>
<div class="yi-alert__body">
<div class="yi-alert__message">This workspace is archived and read-only.</div>
</div>
</div>
</div>
