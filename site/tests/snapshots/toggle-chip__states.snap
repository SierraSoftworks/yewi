<div class="yi-stack">
<div role="group" aria-label="Small" class="yi-toggle-chip-group">
<button type="button" aria-pressed="false" class="yi-toggle-chip">
<span class="yi-toggle-chip__label">Off</span>
</button>
<button type="button" aria-pressed="true" class="yi-toggle-chip">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon">
<path d="M20 6 9 17l-5-5">
</path>
</svg>
<span class="yi-toggle-chip__label">On</span>
</button>
<button type="button" aria-pressed="false" disabled="disabled" class="yi-toggle-chip">
<span class="yi-toggle-chip__label">Off, disabled</span>
</button>
<button type="button" aria-pressed="true" disabled="disabled" class="yi-toggle-chip">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon">
<path d="M20 6 9 17l-5-5">
</path>
</svg>
<span class="yi-toggle-chip__label">On, disabled</span>
</button>
</div>
<div role="group" aria-label="Medium" class="yi-toggle-chip-group">
