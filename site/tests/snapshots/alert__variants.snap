<div style="--yi-grid-min:18rem" class="yi-grid">
<div class="yi-stack">
<div role="status" class="yi-alert yi-alert--info yi-alert--soft">
<span class="yi-alert__icon">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon">
<path d="M2 12a10 10 0 1 0 20 0a10 10 0 1 0 -20 0M12 16v-4M12 8h.01">
</path>
</svg>
</span>
<div class="yi-alert__body">
<div class="yi-alert__title">Maintenance tonight</div>
<div class="yi-alert__message">Probes pause between 22:00 and 22:30 UTC.</div>
</div>
</div>
<div role="alert" class="yi-alert yi-alert--warn yi-alert--soft">
<span class="yi-alert__icon">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon">
<path d="M21.73 18l-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3M12 9v4M12 17h.01">
</path>
</svg>
</span>
<div class="yi-alert__body">
<div class="yi-alert__title">Probe is flapping</div>
<div class="yi-alert__message">4 state changes in the last hour.</div>
</div>
</div>
<div role="alert" class="yi-alert yi-alert--danger yi-alert--soft">
<span class="yi-alert__icon">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon">
<path d="M2 12a10 10 0 1 0 20 0a10 10 0 1 0 -20 0M12 8L12 12M12 16L12.01 16">
</path>
</svg>
</span>
<div class="yi-alert__body">
<div class="yi-alert__title">Refresh failed</div>
<div class="yi-alert__message">The agent did not respond within 10 seconds.</div>
</div>
</div>
</div>
