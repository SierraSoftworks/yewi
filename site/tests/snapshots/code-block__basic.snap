<span class="yi-tok-keyword">use</span> yew::prelude::*;
<span class="yi-tok-keyword">use</span> yewi::prelude::*;

<span class="yi-tok-comment">/// The landing page of the deploy console.</span>
<span class="yi-tok-meta">#[function_component]</span>
<span class="yi-tok-keyword">pub</span> <span class="yi-tok-keyword">fn</span> <span class="yi-tok-type">App</span>() -&gt; <span class="yi-tok-type">Html</span> {
    <span class="yi-tok-keyword">let</span> rollouts = <span class="yi-tok-function">use_state</span>(|| <span class="yi-tok-number">0_u32</span>);
    <span class="yi-tok-keyword">let</span> on_click = {
        <span class="yi-tok-keyword">let</span> rollouts = rollouts.<span class="yi-tok-function">clone</span>();
        <span class="yi-tok-type">Callback</span>::<span class="yi-tok-function">from</span>(<span class="yi-tok-keyword">move</span> |_| rollouts.<span class="yi-tok-function">set</span>(*rollouts + <span class="yi-tok-number">1</span>))
    };

    <span class="yi-tok-meta">html!</span> {
        &lt;<span class="yi-tok-type">Stack</span>&gt;
            &lt;<span class="yi-tok-type">Button</span> variant={<span class="yi-tok-type">ButtonVariant</span>::<span class="yi-tok-type">Primary</span>} {on_click}&gt;{ <span class="yi-tok-string">"Deploy"</span> }&lt;/<span class="yi-tok-type">Button</span>&gt;
            &lt;span&gt;{ <span class="yi-tok-meta">format!</span>(<span class="yi-tok-string">"{} rollouts today"</span>, *rollouts) }&lt;/span&gt;
        &lt;/<span class="yi-tok-type">Stack</span>&gt;
    }
}</code>
