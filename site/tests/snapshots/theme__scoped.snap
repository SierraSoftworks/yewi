<div style="--yi-gap:var(--yi-space-sm);--yi-grid-columns:2" class="yi-grid yi-grid--fixed">
<div data-theme="light" class="demo-panel">
<div class="yi-stack yi-stack--align-start">
<span>Always light</span>
<button type="button" class="yi-button yi-button--primary yi-button--md">Approve</button>
</div>
</div>
<div data-theme="dark" class="demo-panel">
<div class="yi-stack yi-stack--align-start">
<span>Always dark</span>
<button type="button" class="yi-button yi-button--primary yi-button--md">Approve</button>
</div>
</div>
</div>
