<div style="--yw-gap:var(--yw-space-sm);--yw-grid-columns:2" class="yw-grid yw-grid--fixed">
<div data-theme="light" class="demo-panel">
<div class="yw-stack yw-stack--align-start">
<span>Always light</span>
<button type="button" class="yw-button yw-button--primary yw-button--md">Approve</button>
</div>
</div>
<div data-theme="dark" class="demo-panel">
<div class="yw-stack yw-stack--align-start">
<span>Always dark</span>
<button type="button" class="yw-button yw-button--primary yw-button--md">Approve</button>
</div>
</div>
</div>
