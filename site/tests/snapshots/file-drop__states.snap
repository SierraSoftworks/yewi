---
source: site/tests/snapshots.rs
---
<div style="--yi-grid-min:16rem" class="yi-grid">
<label class="yi-file-drop yi-file-drop--md">
<input type="file" aria-labelledby="yi-0-label" aria-describedby="yi-0-hint" class="yi-file-drop__input">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon yi-file-drop__icon">
<path d="M12 3v12M17 8l-5-5-5 5M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4">
</path>
</svg>
<span class="yi-file-drop__text">
<span id="yi-0-label" class="yi-file-drop__label">Drop a file here, or choose one</span>
<span id="yi-0-hint" class="yi-file-drop__hint">Default</span>
</span>
</label>
<label class="yi-file-drop yi-file-drop--md yi-file-drop--invalid">
<input type="file" aria-invalid="true" aria-labelledby="yi-1-label" aria-describedby="yi-1-hint" class="yi-file-drop__input">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon yi-file-drop__icon">
<path d="M12 3v12M17 8l-5-5-5 5M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4">
</path>
</svg>
<span class="yi-file-drop__text">
<span id="yi-1-label" class="yi-file-drop__label">Drop a file here, or choose one</span>
<span id="yi-1-hint" class="yi-file-drop__hint">Invalid</span>
</span>
</label>
<label class="yi-file-drop yi-file-drop--md yi-file-drop--disabled">
<input type="file" aria-labelledby="yi-2-label" aria-describedby="yi-2-hint" disabled="disabled" class="yi-file-drop__input">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon yi-file-drop__icon">
<path d="M12 3v12M17 8l-5-5-5 5M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4">
</path>
</svg>
<span class="yi-file-drop__text">
<span id="yi-2-label" class="yi-file-drop__label">Drop a file here, or choose one</span>
<span id="yi-2-hint" class="yi-file-drop__hint">Disabled</span>
</span>
</label>
<label aria-busy="true" class="yi-file-drop yi-file-drop--md yi-file-drop--busy">
<input type="file" aria-labelledby="yi-3-label" aria-describedby="yi-3-hint" disabled="disabled" class="yi-file-drop__input">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-spinner yi-file-drop__icon">
<circle cx="12" cy="12" r="9" class="yi-spinner__track">
</circle>
<path d="M12 3a9 9 0 0 1 9 9" class="yi-spinner__arc">
</path>
</svg>
<span class="yi-file-drop__text">
<span id="yi-3-label" class="yi-file-drop__label">Uploading…</span>
<span id="yi-3-hint" class="yi-file-drop__hint">Busy</span>
</span>
</label>
<label class="yi-file-drop yi-file-drop--md">
<input type="file" aria-labelledby="yi-4-label" aria-describedby="yi-4-hint" class="yi-file-drop__input">
<span class="yi-file-drop__text">
<span id="yi-4-label" class="yi-file-drop__label">Drop a file here, or choose one</span>
<span id="yi-4-hint" class="yi-file-drop__hint">Without an icon</span>
</span>
</label>
</div>
