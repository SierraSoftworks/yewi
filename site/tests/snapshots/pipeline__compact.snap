---
source: site/tests/snapshots.rs
---
<div class="yi-pipeline yi-pipeline--compact yi-pipeline--fill">
<ol aria-label="Rollout overview" class="yi-pipeline__track">
<li class="yi-pipeline__step">
<span aria-hidden="true" class="yi-pipeline__link">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon">
<path d="M9 18l6-6-6-6">
</path>
</svg>
</span>
<div class="yi-pipeline-stage">
<div class="yi-pipeline-stage__head">
<div class="yi-pipeline-stage__title-row">
<span class="yi-pipeline-stage__title">canary</span>
<span class="yi-pipeline-stage__status">2/2</span>
</div>
<div class="yi-pipeline-stage__meta">hidden when compact</div>
</div>
<div role="group" aria-label="Hosts in canary" class="yi-pipeline-units">
<span role="img" aria-label="canary 1: done" title="canary 1: done" class="yi-pipeline-unit yi-pipeline-unit--ok yi-pipeline-unit--solid">
</span>
<span role="img" aria-label="canary 2: done" title="canary 2: done" class="yi-pipeline-unit yi-pipeline-unit--ok yi-pipeline-unit--solid">
</span>
</div>
</div>
</li>
<li aria-current="step" class="yi-pipeline__step yi-pipeline__step--current">
<div class="yi-pipeline-gate yi-pipeline-gate--open yi-pipeline-gate--ok">
<span aria-hidden="true" class="yi-pipeline-gate__bar">
</span>
<span aria-hidden="true" class="yi-pipeline-gate__icon">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon">
<path d="M20 6 9 17l-5-5">
</path>
</svg>
</span>
<span class="yi-pipeline-gate__label">
<span class="yi-visually-hidden">Gate: </span>approved</span>
<span aria-hidden="true" class="yi-pipeline-gate__bar">
</span>
</div>
<div class="yi-pipeline-stage">
<div class="yi-pipeline-stage__head">
<div class="yi-pipeline-stage__title-row">
<span class="yi-pipeline-stage__title">edge</span>
<span class="yi-pipeline-stage__status">7/12</span>
</div>
</div>
<div role="group" aria-label="Hosts in edge" class="yi-pipeline-units">
<span role="img" aria-label="edge 1: done" title="edge 1: done" class="yi-pipeline-unit yi-pipeline-unit--ok yi-pipeline-unit--solid">
</span>
<span role="img" aria-label="edge 2: done" title="edge 2: done" class="yi-pipeline-unit yi-pipeline-unit--ok yi-pipeline-unit--solid">
</span>
<span role="img" aria-label="edge 3: done" title="edge 3: done" class="yi-pipeline-unit yi-pipeline-unit--ok yi-pipeline-unit--solid">
</span>
