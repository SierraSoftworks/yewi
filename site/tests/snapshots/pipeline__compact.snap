</span>
<span role="img" aria-label="edge 12: pending" title="edge 12: pending" class="yi-pipeline-unit yi-pipeline-unit--neutral yi-pipeline-unit--hollow">
</span>
</div>
</div>
</li>
<li class="yi-pipeline__step">
<div class="yi-pipeline-gate yi-pipeline-gate--waiting yi-pipeline-gate--neutral">
<span aria-hidden="true" class="yi-pipeline-gate__bar">
</span>
<span aria-hidden="true" class="yi-pipeline-gate__icon">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon">
<path d="M2 12a10 10 0 1 0 20 0a10 10 0 1 0 -20 0M12 6v6l4 2">
</path>
</svg>
</span>
<span class="yi-pipeline-gate__label">
