</span>
<span role="img" aria-label="edge 5: done" title="edge 5: done" class="yi-pipeline-unit yi-pipeline-unit--ok yi-pipeline-unit--solid">
</span>
<span role="img" aria-label="edge 6: done" title="edge 6: done" class="yi-pipeline-unit yi-pipeline-unit--ok yi-pipeline-unit--solid">
</span>
<span role="img" aria-label="edge 7: done" title="edge 7: done" class="yi-pipeline-unit yi-pipeline-unit--ok yi-pipeline-unit--solid">
</span>
<span role="img" aria-label="edge 8: pending" title="edge 8: pending" class="yi-pipeline-unit yi-pipeline-unit--neutral yi-pipeline-unit--hollow">
</span>
<span role="img" aria-label="edge 9: pending" title="edge 9: pending" class="yi-pipeline-unit yi-pipeline-unit--neutral yi-pipeline-unit--hollow">
</span>
<span role="img" aria-label="edge 10: pending" title="edge 10: pending" class="yi-pipeline-unit yi-pipeline-unit--neutral yi-pipeline-unit--hollow">
</span>
