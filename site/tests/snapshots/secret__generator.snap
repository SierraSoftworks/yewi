<div class="yi-stack" style="max-inline-size: 30rem">
<div class="yi-field yi-field--stacked">
<label id="yi-0-label" for="yi-0-control" class="yi-field__label">Webhook secret</label>
<div class="yi-field__body">
<div class="yi-input yi-secret-input yi-input--md yi-input--mono">
<input value="" id="yi-0-control" type="password" placeholder="A long random string" autocomplete="off" autocapitalize="off" spellcheck="false" aria-describedby="yi-0-message" class="yi-secret-input__input">
<span class="yi-secret-input__actions">
<button type="button" aria-label="Show secret" title="Show secret" aria-pressed="false" class="yi-secret-input__action">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon">
<path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0M9 12a3 3 0 1 0 6 0a3 3 0 1 0 -6 0">
</path>
</svg>
</button>
<button type="button" aria-label="Generate a new secret" title="Generate a new secret" class="yi-secret-input__action">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon">
<path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8M21 3v5h-5M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16M8 16H3v5">
</path>
</svg>
</button>
</span>
</div>
<p id="yi-0-message" class="yi-field__message">Enter the same value in the provider's webhook settings.</p>
</div>
</div>
<span role="status">Saved a secret of 0 characters</span>
</div>
