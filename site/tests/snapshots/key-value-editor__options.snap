---
source: site/tests/snapshots.rs
---
<div style="--yi-gap:var(--yi-space-lg)" class="yi-stack">
<div role="group" aria-labelledby="yi-0-label" aria-describedby="yi-0-message" class="yi-field yi-field--stacked">
<span id="yi-0-label" class="yi-field__label">Request headers</span>
<div class="yi-field__body">
<div role="group" aria-labelledby="yi-0-label" class="yi-key-value-editor yi-key-value-editor--bare" style="--yi-key-value-editor-key-width: 12rem">
<div class="yi-key-value-editor__row">
<input value="Accept" type="text" placeholder="Header" autocomplete="off" class="yi-input yi-input--md yi-key-value-editor__key" aria-label="Key, header 1">
<input value="application/json" type="text" placeholder="Value" autocomplete="off" class="yi-input yi-input--md yi-key-value-editor__value" aria-label="Value, header 1">
<button type="button" class="yi-button yi-button--subtle yi-button--md yi-button--icon-only yi-key-value-editor__remove" aria-label="Remove header 1" title="Remove header 1">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon">
<path d="M18 6 6 18M6 6l12 12">
</path>
</svg>
</button>
</div>
<button type="button" class="yi-button yi-button--default yi-button--sm yi-key-value-editor__add">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon">
<path d="M5 12h14M12 5v14">
</path>
</svg>Add header</button>
</div>
<p id="yi-0-message" class="yi-field__message">Up to three.</p>
</div>
</div>
<div role="group" aria-labelledby="yi-2-label" aria-describedby="yi-2-message" class="yi-field yi-field--stacked">
<span id="yi-2-label" class="yi-field__label">Inherited labels</span>
<div class="yi-field__body">
<div role="group" aria-labelledby="yi-2-label" class="yi-key-value-editor">
<div class="yi-key-value-editor__row">
<input value="cluster" type="text" placeholder="key" autocomplete="off" spellcheck="false" disabled="disabled" class="yi-input yi-input--md yi-input--mono yi-key-value-editor__key" aria-label="Key, label 1">
<span aria-hidden="true" class="yi-key-value-editor__separator">=</span>
<input value="fra-1" type="text" placeholder="value" autocomplete="off" spellcheck="false" disabled="disabled" class="yi-input yi-input--md yi-input--mono yi-key-value-editor__value" aria-label="Value, label 1">
<button type="button" disabled="disabled" class="yi-button yi-button--subtle yi-button--md yi-button--icon-only yi-key-value-editor__remove" aria-label="Remove label 1" title="Remove label 1">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon">
<path d="M18 6 6 18M6 6l12 12">
</path>
</svg>
</button>
</div>
<div class="yi-key-value-editor__row">
<input value="owner" type="text" placeholder="key" autocomplete="off" spellcheck="false" disabled="disabled" class="yi-input yi-input--md yi-input--mono yi-key-value-editor__key" aria-label="Key, label 2">
<span aria-hidden="true" class="yi-key-value-editor__separator">=</span>
<input value="platform" type="text" placeholder="value" autocomplete="off" spellcheck="false" disabled="disabled" class="yi-input yi-input--md yi-input--mono yi-key-value-editor__value" aria-label="Value, label 2">
<button type="button" disabled="disabled" class="yi-button yi-button--subtle yi-button--md yi-button--icon-only yi-key-value-editor__remove" aria-label="Remove label 2" title="Remove label 2">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon">
<path d="M18 6 6 18M6 6l12 12">
</path>
</svg>
</button>
</div>
<button type="button" disabled="disabled" class="yi-button yi-button--default yi-button--sm yi-key-value-editor__add">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon">
<path d="M5 12h14M12 5v14">
</path>
</svg>Add row</button>
</div>
<p id="yi-2-message" class="yi-field__message">Set by the cluster, so they can't be changed here.</p>
</div>
</div>
</div>
