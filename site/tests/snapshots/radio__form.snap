---
source: site/tests/snapshots.rs
---
<form style="max-inline-size: 22rem" novalidate="novalidate">
<div class="yi-stack">
<div role="group" aria-labelledby="yi-0-label" class="yi-field yi-field--stacked">
<span id="yi-0-label" class="yi-field__label">Region<span aria-hidden="true" class="yi-field__required">*</span>
</span>
<div class="yi-field__body">
<div role="radiogroup" aria-labelledby="yi-0-label" aria-required="true" class="yi-radio-group yi-radio-group--vertical">
<label class="yi-choice yi-choice--md yi-radio">
<span class="yi-choice__control">
<input value="eu-west-1" type="radio" name="region" required="required" class="yi-radio__input">
</span>
<span class="yi-choice__text">
<span class="yi-choice__label">Ireland</span>
</span>
</label>
<label class="yi-choice yi-choice--md yi-radio">
<span class="yi-choice__control">
<input value="us-east-1" type="radio" name="region" required="required" class="yi-radio__input">
</span>
<span class="yi-choice__text">
<span class="yi-choice__label">Virginia</span>
</span>
</label>
<label class="yi-choice yi-choice--md yi-radio">
<span class="yi-choice__control">
<input value="ap-southeast-2" type="radio" name="region" required="required" class="yi-radio__input">
</span>
<span class="yi-choice__text">
<span class="yi-choice__label">Sydney</span>
</span>
</label>
</div>
</div>
</div>
<div class="yi-cluster">
<button type="submit" class="yi-button yi-button--primary yi-button--md">Create cluster</button>
</div>
<span role="status">
</span>
</div>
</form>
