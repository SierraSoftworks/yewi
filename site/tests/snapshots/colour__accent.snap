<div style="--yi-gap:var(--yi-space-sm);--yi-grid-min:15rem" class="yi-grid">
<div data-yi-scope="" style="--yi-accent: light-dark(#409eff, #69b4ff)" class="demo-panel">
<div class="yi-stack yi-stack--align-start">
<b>Default</b>
<div class="yi-cluster">
<button type="button" class="yi-button yi-button--primary yi-button--md">Approve</button>
<button type="button" class="yi-button yi-button--default yi-button--md">Cancel</button>
</div>
<a href="#accent">A link in the accent</a>
<span style="color: var(--yi-fg-muted)">Supporting text on a tinted neutral</span>
<span style="background: var(--yi-accent-soft); color: var(--yi-accent-text)" class="demo-chip">Soft accent</span>
</div>
</div>
