<div style="--yw-gap:var(--yw-space-sm);--yw-grid-min:15rem" class="yw-grid">
<div data-yw-scope="" style="--yw-accent: light-dark(#409eff, #69b4ff)" class="demo-panel">
<div class="yw-stack yw-stack--align-start">
<b>Default</b>
<div class="yw-cluster">
<button type="button" class="yw-button yw-button--primary yw-button--md">Approve</button>
<button type="button" class="yw-button yw-button--default yw-button--md">Cancel</button>
</div>
<a href="#accent">A link in the accent</a>
<span style="color: var(--yw-fg-muted)">Supporting text on a tinted neutral</span>
<span style="background: var(--yw-accent-soft); color: var(--yw-accent-text)" class="demo-chip">Soft accent</span>
</div>
</div>
