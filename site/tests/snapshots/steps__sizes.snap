<div style="--yi-gap:var(--yi-space-xl)" class="yi-stack">
<div class="yi-steps yi-steps--horizontal yi-steps--sm">
<ol aria-label="Small steps" class="yi-steps__list">
<li class="yi-step yi-step--done">
<span aria-hidden="true" class="yi-step__marker">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon">
<path d="M15 6a9 9 0 0 0-9 9V3M15 6a3 3 0 1 0 6 0a3 3 0 1 0 -6 0M3 18a3 3 0 1 0 6 0a3 3 0 1 0 -6 0">
</path>
</svg>
</span>
<span aria-hidden="true" class="yi-step__rail">
</span>
<div class="yi-step__body">
<div class="yi-step__head">
<span class="yi-step__title">Source</span>
<span class="yi-visually-hidden">, completed</span>
</div>
</div>
</li>
