---
source: site/tests/snapshots.rs
---
<div class="yi-stack" style="max-inline-size: 36rem">
<div class="yi-cluster yi-cluster--nowrap">
<div class="yi-input-group yi-input-group--sm yi-search-input">
<span class="yi-input-group__affix yi-input-group__affix--prefix">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon">
<path d="M21 21l-4.34-4.34M3 11a8 8 0 1 0 16 0a8 8 0 1 0 -16 0">
</path>
</svg>
</span>
<input value="api" type="search" placeholder="Search" autocomplete="off" class="yi-input yi-input--md" aria-label="Small search">
<span class="yi-input-group__affix yi-input-group__affix--suffix">
<button type="button" tabindex="-1" aria-label="Clear search" class="yi-search-input__clear">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="yi-icon">
<path d="M18 6 6 18M6 6l12 12">
</path>
</svg>
</button>
</span>
</div>
<div class="yi-input-group yi-input-group--sm">
<span class="yi-input-group__affix yi-input-group__affix--prefix">https://</span>
<input type="text" placeholder="Small" class="yi-input yi-input--md" aria-label="Small">
<span class="yi-input-group__affix yi-input-group__affix--suffix">
<button type="button" class="yi-button yi-button--default yi-button--md">Check</button>
</span>
</div>
<button type="button" class="yi-button yi-button--default yi-button--sm">Apply</button>
</div>
